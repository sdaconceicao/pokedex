# On Vercel, DATABASE_URL (pooled) is injected automatically by the Neon
# integration — do not set it by hand. Migrations run in CI against the
# integration's DATABASE_URL_UNPOOLED value (see .github/workflows/migrate.yml).
# Preview deployments get an isolated Neon branch DB (enable preview branching
# in the integration) and apply their own migrations at build time (vercel.json).
NODE_ENV=production
PORT=3004

DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require

JWT_SECRET=generate-a-strong-random-secret
ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC=3600
PASSWORD_RESET_TOKEN_VALIDITY_DURATION_IN_SEC=900
EMAIL_VERIFICATION_TOKEN_VALIDITY_DURATION_IN_SEC=86400
# '*' matches one hostname label — the second entry covers preview deployments
ALLOWED_ORIGINS=https://pokedex-frontend.vercel.app,https://pokedex-frontend-*.vercel.app

# Must be the canonical frontend origin — reset links are built from it.
FRONTEND_BASE_URL=https://pokedex-frontend.vercel.app

# Until a sending domain is verified in Resend, onboarding@resend.dev only
# delivers to the account's own verified address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=onboarding@resend.dev

LOG_LEVEL=info
