# On Vercel, DATABASE_URL (pooled) is injected automatically by the Neon
# integration — do not set it by hand. Migrations run in CI against the
# integration's DATABASE_URL_UNPOOLED value (see .github/workflows/migrate.yml).
NODE_ENV=production
PORT=3004

DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require

JWT_SECRET=generate-a-strong-random-secret
ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC=3600
ALLOWED_ORIGINS=https://pokedex-frontend.vercel.app

LOG_LEVEL=info
