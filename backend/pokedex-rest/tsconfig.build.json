{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the incremental cache inside outDir. nest-cli's `deleteOutDir` wipes
    // dist before each build, so a buildinfo file left outside it would still
    // claim every output is up to date and tsc would emit nothing — leaving
    // `nest start` to fail on a missing dist/main.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
