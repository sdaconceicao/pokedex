    "@swc/core": "^1.11.29",
    "@vitest/coverage-v8": "^3.2.4",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
