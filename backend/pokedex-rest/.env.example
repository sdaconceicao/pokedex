NODE_ENV=development
PORT=3004

# Local docker-compose Postgres. Setting DATABASE_URL instead overrides
# these and implies a TLS connection (used for hosted DBs like Neon).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=pokedex_user
DB_PASSWORD=pokedex_password
DB_DATABASE=pokedex
DB_SSL=false

JWT_SECRET=abc
ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC=3600
PASSWORD_RESET_TOKEN_VALIDITY_DURATION_IN_SEC=900
# Verification links are long-lived: a new user may not check mail for a day.
# Defaults to 86400 in code if unset.
EMAIL_VERIFICATION_TOKEN_VALIDITY_DURATION_IN_SEC=86400
ALLOWED_ORIGINS=http://localhost:3010

# Fallback base URL for emailed links, used when the request carries no Origin
# header or an Origin that ALLOWED_ORIGINS does not match. Browser requests are
# normally linked back to their own (allow-listed) origin instead, which is how
# preview deployments get working links. Required at boot.
FRONTEND_BASE_URL=http://localhost:3010

# Transactional email (Resend). Leave RESEND_API_KEY blank to disable sending
# locally — MailService then short-circuits instead of calling the API.
RESEND_API_KEY=
MAIL_FROM=pokependium@stephenandrewdesigns.com

LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_MAX_SIZE=100m
LOG_MAX_FILES=7d
LOG_FILENAME=application-%DATE%.log