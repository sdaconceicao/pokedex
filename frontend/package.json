{
  "name": "pokedex-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "prebuild": "pn  codegen",
    "build": "next build",
    "start": "next start",
    "start:dev": "concurrently \"next dev --turbopack --port 3010\" \"pn  codegen:watch\"",
    "start:dev:test": "NODE_ENV=test next dev --port 3010",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@pokemonle/icons-react": "^0.0.3",
    "@tanstack/react-query": "^5.101.2",
    "@untitled-ui/icons-react": "^0.1.4",
    "@vercel/related-projects": "^1.1.0",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "nanoid": "^5.1.16",
    "next": "16.2.10",
    "picocolors": "^1.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__user-event": "^4.1.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/expect": "^4.1.10",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
